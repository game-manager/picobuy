{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picobuy-production",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "picobuy-production",
      "database_id": "9ac1722f-2b04-4562-9a63-6cdfeb612b8b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}

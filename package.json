{
  "name": "picobuy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler d1 migrations apply picobuy-production --local && wrangler dev",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply picobuy-production --remote && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
